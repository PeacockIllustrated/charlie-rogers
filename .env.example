# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (shared project database; all our tables use the charlie_ prefix)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=

# Sentry (error monitoring)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Places map, optional. See docs/MAP.md.
#
# The base map falls back to OpenStreetMap's own tiles when these are unset.
NEXT_PUBLIC_BASE_TILE_URL=
NEXT_PUBLIC_BASE_TILE_ATTRIBUTION=
#
# The historic Ordnance Survey overlay. The toggle on /places only appears once
# a URL and an attribution are set here. Leave blank until the National Library
# of Scotland licensing in docs/MAP.md is settled: this is a commercial site,
# so their free non-commercial tier does not cover it.
NEXT_PUBLIC_HISTORIC_TILE_URL=
NEXT_PUBLIC_HISTORIC_TILE_ATTRIBUTION=
NEXT_PUBLIC_HISTORIC_TILE_LABEL=
NEXT_PUBLIC_HISTORIC_TILE_MAX_ZOOM=
NEXT_PUBLIC_HISTORIC_TILE_MIN_ZOOM=
